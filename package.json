{
  "name": "khnum",
  "version": "1.0.0",
  "description": "A lightweight library for creating web components easily.",
  "keywords": [
    "web-components",
    "custom-elements",
    "hyperscript",
    "dom"
  ],
  "homepage": "https://github.com/alessandrofascini/khnum#readme",
  "bugs": {
    "url": "https://github.com/alessandrofascini/khnum/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alessandrofascini/khnum.git"
  },
  "type": "module",
  "main": "./dist/khnum.umd.cjs",
  "module": "./dist/khnum.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/khnum.js",
      "require": "./dist/khnum.umd.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "bench": "vitest bench",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "license": "MIT",
  "author": "Alessandro Fascini",
  "devDependencies": {
    "@typescript/typescript6": "^6.0.2",
    "@vitest/coverage-v8": "^5.0.1",
    "fast-check": "^4.10.1",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.0",
    "vitest": "^5.0.1"
  }
}
