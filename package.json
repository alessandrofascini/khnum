{
  "name": "khnum",
  "version": "0.1.0",
  "description": "A lightweight library for creating web components easily.",
  "type": "module",
  "main": "./dist/khnum.umd.cjs",
  "module": "./dist/khnum.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/khnum.js",
      "require": "./dist/khnum.umd.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "license": "MIT",
  "author": "Alessandro Fascini",
  "devDependencies": {
    "@typescript/typescript6": "^6.0.2",
    "happy-dom": "^20.14.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.0",
    "vitest": "^5.0.1"
  }
}
